# Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:password@localhost:5432/estaff_portal

# JWT Configuration
# Secret key for signing and verifying JSON Web Tokens
JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production
# Token expiration time (e.g., 1h, 24h, 7d)
JWT_EXPIRES_IN=8h

# Server Configuration
PORT=3000
NODE_ENV=development

# Windows AD Integration (Optional/Environment Specific)
# If using headers from IIS/Reverse Proxy for AD identity
AD_DOMAIN=SAUDIA.LOCAL